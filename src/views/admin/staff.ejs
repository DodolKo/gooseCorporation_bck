<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary-color: #2563eb;
            --dark-color: #1e293b;
            --light-color: #f8fafc;
            --success-color: #10b981;
            --danger-color: #ef4444;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--light-color);
        }

        .navbar-brand {
            font-weight: bold;
            color: var(--primary-color) !important;
        }

        .sidebar {
            background-color: var(--dark-color);
            min-height: calc(100vh - 56px);
            padding: 1rem 0;
        }

        .sidebar .nav-link {
            color: #cbd5e1;
            padding: 0.75rem 1.5rem;
            border-radius: 0.375rem;
            margin: 0.25rem 1rem;
            transition: all 0.2s;
        }

        .sidebar .nav-link:hover {
            background-color: var(--primary-color);
            color: white;
        }

        .sidebar .nav-link.active {
            background-color: var(--primary-color);
            color: white;
        }

        .main-content {
            padding: 2rem;
        }

        .card {
            border: none;
            border-radius: 0.75rem;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
        }

        .search-form {
            background-color: white;
            padding: 1.5rem;
            border-radius: 0.75rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand" href="/admin/dashboard">
                <i class="fas fa-building me-2"></i>
                GooseCorp Admin
            </a>
            <div class="navbar-nav ms-auto">
                <div class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown">
                        <i class="fas fa-user me-2"></i>
                        <%= user.email %>
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="/admin/logout">
                            <i class="fas fa-sign-out-alt me-2"></i>
                            Déconnexion
                        </a></li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <nav class="col-md-3 col-lg-2 d-md-block sidebar">
                <div class="position-sticky">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link" href="/admin/dashboard">
                                <i class="fas fa-tachometer-alt me-2"></i>
                                Tableau de bord
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/admin/current-visitors">
                                <i class="fas fa-users me-2"></i>
                                Visiteurs actuels
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/admin/visitors">
                                <i class="fas fa-user-friends me-2"></i>
                                Gestion visiteurs
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link active" href="/admin/staff">
                                <i class="fas fa-user-tie me-2"></i>
                                Gestion personnel
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/admin/formations">
                                <i class="fas fa-graduation-cap me-2"></i>
                                Gestion formations
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/admin/history">
                                <i class="fas fa-history me-2"></i>
                                Historique
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <!-- Main content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2">
                        <i class="fas fa-user-tie me-2"></i>
                        Gestion du personnel
                        <span class="badge bg-primary ms-2"><%= totalCount %></span>
                    </h1>
                    <div class="btn-toolbar mb-2 mb-md-0">
                        <div class="btn-group me-2">
                            <button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#addStaffModal">
                                <i class="fas fa-plus me-1"></i>
                                Ajouter personnel
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Search Form -->
                <div class="search-form">
                    <form method="GET" action="/admin/staff">
                        <div class="row">
                            <div class="col-md-4">
                                <input type="text" class="form-control" name="search" placeholder="Rechercher..." value="<%= filters.search %>">
                            </div>
                            <div class="col-md-3">
                                <input type="text" class="form-control" name="department" placeholder="Département" value="<%= filters.department %>">
                            </div>
                            <div class="col-md-3">
                                <select class="form-select" name="isActive">
                                    <option value="">Tous les statuts</option>
                                    <option value="true" <%= filters.isActive === 'true' ? 'selected' : '' %>>Actifs</option>
                                    <option value="false" <%= filters.isActive === 'false' ? 'selected' : '' %>>Inactifs</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="fas fa-search me-1"></i>
                                    Rechercher
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- Staff Table -->
                <div class="card">
                    <div class="card-body">
                        <% if (staff && staff.length > 0) { %>
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Nom</th>
                                            <th>Email</th>
                                            <th>Département</th>
                                            <th>Poste</th>
                                            <th>Bureau</th>
                                            <th>Statut</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% staff.forEach(member => { %>
                                            <tr>
                                                <td>
                                                    <strong><%= member.firstName %> <%= member.lastName %></strong>
                                                </td>
                                                <td><%= member.email %></td>
                                                <td><%= member.department || '-' %></td>
                                                <td><%= member.position || '-' %></td>
                                                <td><%= member.office || '-' %></td>
                                                <td>
                                                    <% if (member.isActive) { %>
                                                        <span class="badge bg-success">Actif</span>
                                                    <% } else { %>
                                                        <span class="badge bg-secondary">Inactif</span>
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <div class="btn-group btn-group-sm">
                                                        <button class="btn btn-outline-primary btn-edit-staff" title="Modifier" 
                                                                data-id="<%= member.id %>"
                                                                data-firstname="<%= member.firstName || '' %>"
                                                                data-lastname="<%= member.lastName || '' %>"
                                                                data-email="<%= member.email || '' %>"
                                                                data-phone="<%= member.phone || '' %>"
                                                                data-department="<%= member.department || '' %>"
                                                                data-position="<%= member.position || '' %>"
                                                                data-office="<%= member.office || '' %>"
                                                                data-isactive="<%= member.isActive %>">
                                                            <i class="fas fa-edit"></i>
                                                        </button>
                                                        <button class="btn btn-outline-danger btn-delete-staff" title="Supprimer" data-id="<%= member.id %>">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>

                            <!-- Pagination -->
                            <% if (pagination.totalPages > 1) { %>
                                <nav class="mt-4">
                                    <ul class="pagination justify-content-center">
                                        <% if (pagination.hasPrev) { %>
                                            <li class="page-item">
                                                <a class="page-link" href="?page=<%= pagination.prevPage %>&search=<%= filters.search %>&department=<%= filters.department %>&isActive=<%= filters.isActive %>">
                                                    Précédent
                                                </a>
                                            </li>
                                        <% } %>
                                        
                                        <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                                            <li class="page-item <%= pagination.page === i ? 'active' : '' %>">
                                                <a class="page-link" href="?page=<%= i %>&search=<%= filters.search %>&department=<%= filters.department %>&isActive=<%= filters.isActive %>">
                                                    <%= i %>
                                                </a>
                                            </li>
                                        <% } %>
                                        
                                        <% if (pagination.hasNext) { %>
                                            <li class="page-item">
                                                <a class="page-link" href="?page=<%= pagination.nextPage %>&search=<%= filters.search %>&department=<%= filters.department %>&isActive=<%= filters.isActive %>">
                                                    Suivant
                                                </a>
                                            </li>
                                        <% } %>
                                    </ul>
                                </nav>
                            <% } %>
                        <% } else { %>
                            <div class="text-center py-5">
                                <i class="fas fa-user-tie fa-4x text-muted mb-3"></i>
                                <h4 class="text-muted">Aucun membre du personnel trouvé</h4>
                                <p class="text-muted">Ajoutez des membres du personnel pour commencer.</p>
                            </div>
                        <% } %>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- Add Staff Modal -->
    <div class="modal fade" id="addStaffModal" tabindex="-1" aria-labelledby="addStaffModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addStaffModalLabel">
                        <i class="fas fa-user-plus me-2"></i>
                        Ajouter un membre du personnel
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="addStaffForm">
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="firstName" class="form-label">Prénom *</label>
                                    <input type="text" class="form-control" id="firstName" name="firstName" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="lastName" class="form-label">Nom *</label>
                                    <input type="text" class="form-control" id="lastName" name="lastName" required>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="email" class="form-label">Email *</label>
                                    <input type="email" class="form-control" id="email" name="email" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="phone" class="form-label">Téléphone</label>
                                    <input type="tel" class="form-control" id="phone" name="phone" placeholder="+32 123 456 789">
                                    <div class="form-text">Format: +32 123 456 789 ou +33 1 23 45 67 89</div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="department" class="form-label">Département</label>
                                    <input type="text" class="form-control" id="department" name="department">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="position" class="form-label">Poste</label>
                                    <input type="text" class="form-control" id="position" name="position">
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="office" class="form-label">Bureau</label>
                                    <input type="text" class="form-control" id="office" name="office">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="isActive" class="form-label">Statut</label>
                                    <select class="form-select" id="isActive" name="isActive">
                                        <option value="true">Actif</option>
                                        <option value="false">Inactif</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-save me-1"></i>
                            Ajouter
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal d'édition de personnel -->
    <div class="modal fade" id="editStaffModal" tabindex="-1" aria-labelledby="editStaffModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editStaffModalLabel">
                        <i class="bi bi-pencil me-2"></i>Modifier le personnel
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="editStaffForm">
                    <div class="modal-body">
                        <div class="alert alert-danger d-none" id="editStaffError"></div>
                        <div class="alert alert-success d-none" id="editStaffSuccess"></div>
                        
                        <input type="hidden" id="editStaffId" name="staffId">
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="editFirstName" class="form-label">Prénom *</label>
                                    <input type="text" class="form-control" id="editFirstName" name="firstName" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="editLastName" class="form-label">Nom *</label>
                                    <input type="text" class="form-control" id="editLastName" name="lastName" required>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="editEmail" class="form-label">Email *</label>
                                    <input type="email" class="form-control" id="editEmail" name="email" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="editPhone" class="form-label">Téléphone</label>
                                    <input type="tel" class="form-control" id="editPhone" name="phone" placeholder="+32 123 456 789">
                                    <div class="form-text">Format: +32 123 456 789 ou +33 1 23 45 67 89</div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="editDepartment" class="form-label">Département</label>
                                    <input type="text" class="form-control" id="editDepartment" name="department">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="editPosition" class="form-label">Poste</label>
                                    <input type="text" class="form-control" id="editPosition" name="position">
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="editOffice" class="form-label">Bureau</label>
                                    <input type="text" class="form-control" id="editOffice" name="office">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="editIsActive" class="form-label">Statut</label>
                                    <select class="form-control" id="editIsActive" name="isActive">
                                        <option value="true">Actif</option>
                                        <option value="false">Inactif</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-2"></i>Sauvegarder
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Handle staff form submission
        document.getElementById('addStaffForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const formData = new FormData(this);
            const data = Object.fromEntries(formData);
            
            try {
                const response = await fetch('/admin/staff/add', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    credentials: 'include',
                    body: JSON.stringify(data)
                });
                
                const result = await response.json();
                
                if (result.success) {
                    bootstrap.Modal.getInstance(document.getElementById('addStaffModal')).hide();
                    location.reload();
                } else {
                    alert('Erreur: ' + (result.error || result.errors?.[0]?.msg || 'Erreur inconnue'));
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Erreur lors de l\'ajout du personnel');
            }
        });

        // Event listeners pour les boutons d'édition du personnel
        document.addEventListener('click', function(e) {
            if (e.target.closest('.btn-edit-staff')) {
                const btn = e.target.closest('.btn-edit-staff');
                const staffId = btn.getAttribute('data-id');
                const firstName = btn.getAttribute('data-firstname');
                const lastName = btn.getAttribute('data-lastname');
                const email = btn.getAttribute('data-email');
                const phone = btn.getAttribute('data-phone');
                const department = btn.getAttribute('data-department');
                const position = btn.getAttribute('data-position');
                const office = btn.getAttribute('data-office');
                const isActive = btn.getAttribute('data-isactive');
                
                // Remplir le formulaire avec les données existantes
                document.getElementById('editStaffId').value = staffId;
                document.getElementById('editFirstName').value = firstName || '';
                document.getElementById('editLastName').value = lastName || '';
                document.getElementById('editEmail').value = email || '';
                document.getElementById('editPhone').value = phone || '';
                document.getElementById('editDepartment').value = department || '';
                document.getElementById('editPosition').value = position || '';
                document.getElementById('editOffice').value = office || '';
                document.getElementById('editIsActive').value = isActive;
                
                // Afficher la modale
                const modal = new bootstrap.Modal(document.getElementById('editStaffModal'));
                modal.show();
            }
        });

        // Gestionnaire pour le formulaire de modification
        document.getElementById('editStaffForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const staffId = document.getElementById('editStaffId').value;
            const formData = new FormData(this);
            
            // Convertir FormData en objet
            const data = {};
            formData.forEach((value, key) => {
                if (key !== 'staffId') {
                    data[key] = value;
                }
            });
            
            console.log('Staff ID:', staffId);
            console.log('Data to send:', data);
            
            // Envoyer la requête de modification
            fetch(`/admin/staff/edit/${staffId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                credentials: 'include',
                body: JSON.stringify(data)
            })
            .then(response => {
                console.log('Response status:', response.status);
                console.log('Response headers:', response.headers);
                return response.json();
            })
            .then(data => {
                console.log('Response data:', data);
                if (data.success) {
                    // Afficher le message de succès
                    document.getElementById('editStaffSuccess').textContent = 'Personnel modifié avec succès!';
                    document.getElementById('editStaffSuccess').classList.remove('d-none');
                    document.getElementById('editStaffError').classList.add('d-none');
                    
                    // Fermer la modale après un délai
                    setTimeout(() => {
                        const modal = bootstrap.Modal.getInstance(document.getElementById('editStaffModal'));
                        modal.hide();
                        window.location.reload(); // Recharger la page
                    }, 1500);
                } else {
                    // Afficher les erreurs
                    let errorMessage = data.error || 'Erreur lors de la modification';
                    if (data.errors) {
                        errorMessage = data.errors.map(err => err.msg).join(', ');
                    }
                    document.getElementById('editStaffError').textContent = errorMessage;
                    document.getElementById('editStaffError').classList.remove('d-none');
                    document.getElementById('editStaffSuccess').classList.add('d-none');
                }
            })
            .catch(error => {
                console.error('Erreur:', error);
                document.getElementById('editStaffError').textContent = 'Erreur lors de la modification';
                document.getElementById('editStaffError').classList.remove('d-none');
                document.getElementById('editStaffSuccess').classList.add('d-none');
            });
        });

        // Event listeners pour les boutons de suppression du personnel
        document.addEventListener('click', function(e) {
            if (e.target.closest('.btn-delete-staff')) {
                const btn = e.target.closest('.btn-delete-staff');
                const staffId = btn.getAttribute('data-id');
                
                if (confirm('Êtes-vous sûr de vouloir supprimer ce personnel ?')) {
                    fetch(`/admin/staff/delete/${staffId}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        credentials: 'include'
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            alert('Personnel supprimé avec succès');
                            window.location.reload();
                        } else {
                            alert('Erreur lors de la suppression: ' + (data.error || 'Erreur inconnue'));
                        }
                    })
                    .catch(error => {
                        console.error('Erreur:', error);
                        alert('Erreur lors de la suppression');
                    });
                }
            }
        });
    </script>
</body>
</html> 