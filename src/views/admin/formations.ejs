<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary-color: #2563eb;
            --dark-color: #1e293b;
            --light-color: #f8fafc;
            --success-color: #10b981;
            --warning-color: #f59e0b;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--light-color);
        }

        .navbar-brand {
            font-weight: bold;
            color: var(--primary-color) !important;
        }

        .sidebar {
            background-color: var(--dark-color);
            min-height: calc(100vh - 56px);
            padding: 1rem 0;
        }

        .sidebar .nav-link {
            color: #cbd5e1;
            padding: 0.75rem 1.5rem;
            border-radius: 0.375rem;
            margin: 0.25rem 1rem;
            transition: all 0.2s;
        }

        .sidebar .nav-link:hover {
            background-color: var(--primary-color);
            color: white;
        }

        .sidebar .nav-link.active {
            background-color: var(--primary-color);
            color: white;
        }

        .main-content {
            padding: 2rem;
        }

        .card {
            border: none;
            border-radius: 0.75rem;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
        }

        .search-form {
            background-color: white;
            padding: 1.5rem;
            border-radius: 0.75rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand" href="/admin/dashboard">
                <i class="fas fa-building me-2"></i>
                GooseCorp Admin
            </a>
            <div class="navbar-nav ms-auto">
                <div class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown">
                        <i class="fas fa-user me-2"></i>
                        <%= user.email %>
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="/admin/logout">
                            <i class="fas fa-sign-out-alt me-2"></i>
                            Déconnexion
                        </a></li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <nav class="col-md-3 col-lg-2 d-md-block sidebar">
                <div class="position-sticky">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link" href="/admin/dashboard">
                                <i class="fas fa-tachometer-alt me-2"></i>
                                Tableau de bord
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/admin/current-visitors">
                                <i class="fas fa-users me-2"></i>
                                Visiteurs actuels
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/admin/visitors">
                                <i class="fas fa-user-friends me-2"></i>
                                Gestion visiteurs
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/admin/staff">
                                <i class="fas fa-user-tie me-2"></i>
                                Gestion personnel
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link active" href="/admin/formations">
                                <i class="fas fa-graduation-cap me-2"></i>
                                Gestion formations
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/admin/history">
                                <i class="fas fa-history me-2"></i>
                                Historique
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <!-- Main content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2">
                        <i class="fas fa-graduation-cap me-2"></i>
                        Gestion des formations
                        <span class="badge bg-primary ms-2"><%= totalCount %></span>
                    </h1>
                    <div class="btn-toolbar mb-2 mb-md-0">
                        <div class="btn-group me-2">
                            <button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#addFormationModal">
                                <i class="fas fa-plus me-1"></i>
                                Ajouter formation
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Search Form -->
                <div class="search-form">
                    <form method="GET" action="/admin/formations">
                        <div class="row">
                            <div class="col-md-4">
                                <input type="text" class="form-control" name="search" placeholder="Rechercher..." value="<%= filters.search %>">
                            </div>
                            <div class="col-md-3">
                                <select class="form-select" name="isActive">
                                    <option value="">Tous les statuts</option>
                                    <option value="true" <%= filters.isActive === 'true' ? 'selected' : '' %>>Actives</option>
                                    <option value="false" <%= filters.isActive === 'false' ? 'selected' : '' %>>Inactives</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <input type="date" class="form-control" name="startDate" placeholder="Date de début">
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="fas fa-search me-1"></i>
                                    Rechercher
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- Formations Table -->
                <div class="card">
                    <div class="card-body">
                        <% if (formations && formations.length > 0) { %>
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Nom</th>
                                            <th>Description</th>
                                            <th>Lieu</th>
                                            <th>Instructeur</th>
                                            <th>Date début</th>
                                            <th>Participants</th>
                                            <th>Statut</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% formations.forEach(formation => { %>
                                            <tr>
                                                <td>
                                                    <strong><%= formation.name %></strong>
                                                </td>
                                                <td>
                                                    <% if (formation.description) { %>
                                                        <%= formation.description.length > 50 ? formation.description.substring(0, 50) + '...' : formation.description %>
                                                    <% } else { %>
                                                        -
                                                    <% } %>
                                                </td>
                                                <td><%= formation.location %></td>
                                                <td><%= formation.instructor || '-' %></td>
                                                <td>
                                                    <% if (formation.startDate) { %>
                                                        <%= new Date(formation.startDate).toLocaleDateString('fr-FR') %>
                                                    <% } else { %>
                                                        -
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <span class="badge bg-info">
                                                        <%= formation._count ? formation._count.attendees : 0 %>
                                                        <% if (formation.maxAttendees) { %>
                                                            / <%= formation.maxAttendees %>
                                                        <% } %>
                                                    </span>
                                                </td>
                                                <td>
                                                    <span class="badge bg-<%= formation.isActive ? 'success' : 'danger' %>">
                                                        <%= formation.isActive ? 'Active' : 'Inactive' %>
                                                    </span>
                                                </td>
                                                <td>
                                                    <div class="btn-group btn-group-sm">
                                                        <button class="btn btn-outline-primary btn-edit-formation" title="Modifier" 
                                                                data-id="<%= formation.id %>"
                                                                data-name="<%= formation.name || '' %>"
                                                                data-description="<%= formation.description || '' %>"
                                                                data-location="<%= formation.location || '' %>"
                                                                data-instructor="<%= formation.instructor || '' %>"
                                                                data-maxattendees="<%= formation.maxAttendees || '' %>"
                                                                data-startdate="<%= formation.startDate ? formation.startDate.toISOString() : '' %>"
                                                                data-enddate="<%= formation.endDate ? formation.endDate.toISOString() : '' %>"
                                                                data-isactive="<%= formation.isActive %>">
                                                            <i class="fas fa-edit"></i>
                                                        </button>
                                                        <button class="btn btn-outline-danger btn-delete-formation" title="Supprimer" data-id="<%= formation.id %>">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>

                            <!-- Pagination -->
                            <% if (pagination.totalPages > 1) { %>
                                <nav class="mt-4">
                                    <ul class="pagination justify-content-center">
                                        <% if (pagination.hasPrev) { %>
                                            <li class="page-item">
                                                <a class="page-link" href="?page=<%= pagination.prevPage %>&search=<%= filters.search %>&isActive=<%= filters.isActive %>">
                                                    Précédent
                                                </a>
                                            </li>
                                        <% } %>
                                        
                                        <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                                            <li class="page-item <%= pagination.page === i ? 'active' : '' %>">
                                                <a class="page-link" href="?page=<%= i %>&search=<%= filters.search %>&isActive=<%= filters.isActive %>">
                                                    <%= i %>
                                                </a>
                                            </li>
                                        <% } %>
                                        
                                        <% if (pagination.hasNext) { %>
                                            <li class="page-item">
                                                <a class="page-link" href="?page=<%= pagination.nextPage %>&search=<%= filters.search %>&isActive=<%= filters.isActive %>">
                                                    Suivant
                                                </a>
                                            </li>
                                        <% } %>
                                    </ul>
                                </nav>
                            <% } %>
                        <% } else { %>
                            <div class="text-center py-5">
                                <i class="fas fa-graduation-cap fa-4x text-muted mb-3"></i>
                                <h4 class="text-muted">Aucune formation trouvée</h4>
                                <p class="text-muted">Ajoutez des formations pour commencer.</p>
                            </div>
                        <% } %>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- Add Formation Modal -->
    <div class="modal fade" id="addFormationModal" tabindex="-1" aria-labelledby="addFormationModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addFormationModalLabel">
                        <i class="fas fa-graduation-cap me-2"></i>
                        Ajouter une formation
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="addFormationForm">
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-8">
                                <div class="mb-3">
                                    <label for="name" class="form-label">Nom de la formation *</label>
                                    <input type="text" class="form-control" id="name" name="name" required>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label for="maxAttendees" class="form-label">Participants max</label>
                                    <input type="number" class="form-control" id="maxAttendees" name="maxAttendees" min="1">
                                </div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="description" class="form-label">Description</label>
                            <textarea class="form-control" id="description" name="description" rows="3"></textarea>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="location" class="form-label">Lieu *</label>
                                    <input type="text" class="form-control" id="location" name="location" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="instructor" class="form-label">Instructeur</label>
                                    <input type="text" class="form-control" id="instructor" name="instructor">
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="startDate" class="form-label">Date de début</label>
                                    <input type="datetime-local" class="form-control" id="startDate" name="startDate">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="endDate" class="form-label">Date de fin</label>
                                    <input type="datetime-local" class="form-control" id="endDate" name="endDate">
                                </div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="isActive" class="form-label">Statut</label>
                            <select class="form-select" id="isActive" name="isActive">
                                <option value="true">Active</option>
                                <option value="false">Inactive</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-save me-1"></i>
                            Ajouter
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal d'édition de formation -->
    <div class="modal fade" id="editFormationModal" tabindex="-1" aria-labelledby="editFormationModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editFormationModalLabel">
                        <i class="bi bi-pencil me-2"></i>Modifier la formation
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="editFormationForm">
                    <div class="modal-body">
                        <div class="alert alert-danger d-none" id="editFormationError"></div>
                        <div class="alert alert-success d-none" id="editFormationSuccess"></div>
                        
                        <input type="hidden" id="editFormationId" name="formationId">
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="editFormationName" class="form-label">Nom de la formation *</label>
                                    <input type="text" class="form-control" id="editFormationName" name="name" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="editLocation" class="form-label">Lieu *</label>
                                    <input type="text" class="form-control" id="editLocation" name="location" required>
                                </div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="editDescription" class="form-label">Description</label>
                            <textarea class="form-control" id="editDescription" name="description" rows="3"></textarea>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="editInstructor" class="form-label">Instructeur</label>
                                    <input type="text" class="form-control" id="editInstructor" name="instructor">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="editMaxAttendees" class="form-label">Participants max</label>
                                    <input type="number" class="form-control" id="editMaxAttendees" name="maxAttendees" min="1">
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="editStartDate" class="form-label">Date de début</label>
                                    <input type="datetime-local" class="form-control" id="editStartDate" name="startDate">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="editEndDate" class="form-label">Date de fin</label>
                                    <input type="datetime-local" class="form-control" id="editEndDate" name="endDate">
                                </div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="editFormationIsActive" class="form-label">Statut</label>
                            <select class="form-control" id="editFormationIsActive" name="isActive">
                                <option value="true">Active</option>
                                <option value="false">Inactive</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-2"></i>Sauvegarder
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Handle formation form submission
        document.getElementById('addFormationForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const formData = new FormData(this);
            const data = Object.fromEntries(formData);
            
            // Convert empty strings to null for optional fields
            if (!data.startDate) data.startDate = null;
            if (!data.endDate) data.endDate = null;
            if (!data.maxAttendees) data.maxAttendees = null;
            if (!data.description) data.description = null;
            if (!data.instructor) data.instructor = null;
            
            try {
                const response = await fetch('/admin/formations/add', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    credentials: 'include',
                    body: JSON.stringify(data)
                });
                
                const result = await response.json();
                
                if (result.success) {
                    bootstrap.Modal.getInstance(document.getElementById('addFormationModal')).hide();
                    location.reload();
                } else {
                    alert('Erreur: ' + (result.error || result.errors?.[0]?.msg || 'Erreur inconnue'));
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Erreur lors de l\'ajout de la formation');
            }
        });

        // Event listeners pour les boutons d'édition des formations
        document.addEventListener('click', function(e) {
            if (e.target.closest('.btn-edit-formation')) {
                const btn = e.target.closest('.btn-edit-formation');
                const formationId = btn.getAttribute('data-id');
                const name = btn.getAttribute('data-name');
                const description = btn.getAttribute('data-description');
                const location = btn.getAttribute('data-location');
                const instructor = btn.getAttribute('data-instructor');
                const maxAttendees = btn.getAttribute('data-maxattendees');
                const startDate = btn.getAttribute('data-startdate');
                const endDate = btn.getAttribute('data-enddate');
                const isActive = btn.getAttribute('data-isactive');
                
                // Remplir le formulaire avec les données existantes
                document.getElementById('editFormationId').value = formationId;
                document.getElementById('editFormationName').value = name || '';
                document.getElementById('editLocation').value = location || '';
                document.getElementById('editDescription').value = description || '';
                document.getElementById('editInstructor').value = instructor || '';
                document.getElementById('editMaxAttendees').value = maxAttendees || '';
                document.getElementById('editFormationIsActive').value = isActive;
                
                // Formater les dates pour les inputs datetime-local
                if (startDate) {
                    const startDateTime = new Date(startDate);
                    document.getElementById('editStartDate').value = startDateTime.toISOString().slice(0, 16);
                }
                if (endDate) {
                    const endDateTime = new Date(endDate);
                    document.getElementById('editEndDate').value = endDateTime.toISOString().slice(0, 16);
                }
                
                // Afficher la modale
                const modal = new bootstrap.Modal(document.getElementById('editFormationModal'));
                modal.show();
            }
        });

        // Gestionnaire pour le formulaire de modification
        document.getElementById('editFormationForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const formationId = document.getElementById('editFormationId').value;
            const formData = new FormData(this);
            
            // Convertir FormData en objet
            const data = {};
            formData.forEach((value, key) => {
                if (key !== 'formationId') {
                    data[key] = value;
                }
            });
            
            console.log('Formation ID:', formationId);
            console.log('Data to send:', data);
            
            // Envoyer la requête de modification
            fetch(`/admin/formations/edit/${formationId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                credentials: 'include',
                body: JSON.stringify(data)
            })
            .then(response => {
                console.log('Response status:', response.status);
                console.log('Response headers:', response.headers);
                return response.json();
            })
            .then(data => {
                console.log('Response data:', data);
                if (data.success) {
                    // Afficher le message de succès
                    document.getElementById('editFormationSuccess').textContent = 'Formation modifiée avec succès!';
                    document.getElementById('editFormationSuccess').classList.remove('d-none');
                    document.getElementById('editFormationError').classList.add('d-none');
                    
                    // Fermer la modale après un délai
                    setTimeout(() => {
                        const modal = bootstrap.Modal.getInstance(document.getElementById('editFormationModal'));
                        modal.hide();
                        window.location.reload(); // Recharger la page
                    }, 1500);
                } else {
                    // Afficher les erreurs
                    let errorMessage = data.error || 'Erreur lors de la modification';
                    if (data.errors) {
                        errorMessage = data.errors.map(err => err.msg).join(', ');
                    }
                    document.getElementById('editFormationError').textContent = errorMessage;
                    document.getElementById('editFormationError').classList.remove('d-none');
                    document.getElementById('editFormationSuccess').classList.add('d-none');
                }
            })
            .catch(error => {
                console.error('Erreur:', error);
                document.getElementById('editFormationError').textContent = 'Erreur lors de la modification';
                document.getElementById('editFormationError').classList.remove('d-none');
                document.getElementById('editFormationSuccess').classList.add('d-none');
            });
        });

        // Event listeners pour les boutons de suppression des formations
        document.addEventListener('click', function(e) {
            if (e.target.closest('.btn-delete-formation')) {
                const btn = e.target.closest('.btn-delete-formation');
                const formationId = btn.getAttribute('data-id');
                
                if (confirm('Êtes-vous sûr de vouloir supprimer cette formation ?')) {
                    fetch(`/admin/formations/delete/${formationId}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        credentials: 'include'
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            alert('Formation supprimée avec succès');
                            window.location.reload();
                        } else {
                            alert('Erreur lors de la suppression: ' + (data.error || 'Erreur inconnue'));
                        }
                    })
                    .catch(error => {
                        console.error('Erreur:', error);
                        alert('Erreur lors de la suppression');
                    });
                }
            }
        });
    </script>
</body>
</html> 