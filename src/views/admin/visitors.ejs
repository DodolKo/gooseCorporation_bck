<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary-color: #2563eb;
            --dark-color: #1e293b;
            --light-color: #f8fafc;
            --success-color: #10b981;
            --secondary-color: #64748b;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--light-color);
        }

        .navbar-brand {
            font-weight: bold;
            color: var(--primary-color) !important;
        }

        .sidebar {
            background-color: var(--dark-color);
            min-height: calc(100vh - 56px);
            padding: 1rem 0;
        }

        .sidebar .nav-link {
            color: #cbd5e1;
            padding: 0.75rem 1.5rem;
            border-radius: 0.375rem;
            margin: 0.25rem 1rem;
            transition: all 0.2s;
        }

        .sidebar .nav-link:hover {
            background-color: var(--primary-color);
            color: white;
        }

        .sidebar .nav-link.active {
            background-color: var(--primary-color);
            color: white;
        }

        .main-content {
            padding: 2rem;
        }

        .card {
            border: none;
            border-radius: 0.75rem;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
        }

        .search-form {
            background-color: white;
            padding: 1.5rem;
            border-radius: 0.75rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
        }

        .status-inside {
            background-color: var(--success-color);
        }

        .status-outside {
            background-color: var(--secondary-color);
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand" href="/admin/dashboard">
                <i class="fas fa-building me-2"></i>
                GooseCorp Admin
            </a>
            <div class="navbar-nav ms-auto">
                <div class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown">
                        <i class="fas fa-user me-2"></i>
                        <%= user.email %>
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="/admin/logout">
                            <i class="fas fa-sign-out-alt me-2"></i>
                            Déconnexion
                        </a></li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <nav class="col-md-3 col-lg-2 d-md-block sidebar">
                <div class="position-sticky">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link" href="/admin/dashboard">
                                <i class="fas fa-tachometer-alt me-2"></i>
                                Tableau de bord
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/admin/current-visitors">
                                <i class="fas fa-users me-2"></i>
                                Visiteurs actuels
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link active" href="/admin/visitors">
                                <i class="fas fa-user-friends me-2"></i>
                                Gestion visiteurs
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/admin/staff">
                                <i class="fas fa-user-tie me-2"></i>
                                Gestion personnel
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/admin/formations">
                                <i class="fas fa-graduation-cap me-2"></i>
                                Gestion formations
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/admin/history">
                                <i class="fas fa-history me-2"></i>
                                Historique
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <!-- Main content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2">
                        <i class="fas fa-user-friends me-2"></i>
                        Gestion des visiteurs
                        <span class="badge bg-primary ms-2"><%= totalCount %></span>
                    </h1>
                    <div class="btn-toolbar mb-2 mb-md-0">
                        <div class="btn-group me-2">
                            <button type="button" class="btn btn-sm btn-success">
                                <i class="fas fa-plus me-1"></i>
                                Nouveau visiteur
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Search Form -->
                <div class="search-form">
                    <form method="GET" action="/admin/visitors">
                        <div class="row">
                            <div class="col-md-3">
                                <input type="text" class="form-control" name="search" placeholder="Rechercher..." value="<%= filters.search %>">
                            </div>
                            <div class="col-md-2">
                                <select class="form-select" name="status">
                                    <option value="">Tous les statuts</option>
                                    <option value="INSIDE" <%= filters.status === 'INSIDE' ? 'selected' : '' %>>À l'intérieur</option>
                                    <option value="OUTSIDE" <%= filters.status === 'OUTSIDE' ? 'selected' : '' %>>À l'extérieur</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <select class="form-select" name="visitReason">
                                    <option value="">Toutes les raisons</option>
                                    <option value="MEETING" <%= filters.visitReason === 'MEETING' ? 'selected' : '' %>>Rendez-vous</option>
                                    <option value="FORMATION" <%= filters.visitReason === 'FORMATION' ? 'selected' : '' %>>Formation</option>
                                    <option value="DELIVERY" <%= filters.visitReason === 'DELIVERY' ? 'selected' : '' %>>Livraison</option>
                                    <option value="MAINTENANCE" <%= filters.visitReason === 'MAINTENANCE' ? 'selected' : '' %>>Maintenance</option>
                                    <option value="OTHER" <%= filters.visitReason === 'OTHER' ? 'selected' : '' %>>Autre</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <input type="date" class="form-control" name="date" placeholder="Date">
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="fas fa-search me-1"></i>
                                    Rechercher
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- Visitors Table -->
                <div class="card">
                    <div class="card-body">
                        <% if (visitors && visitors.length > 0) { %>
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Nom</th>
                                            <th>Email</th>
                                            <th>Entreprise</th>
                                            <th>Raison</th>
                                            <th>Arrivée</th>
                                            <th>Sortie</th>
                                            <th>Statut</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% visitors.forEach(visitor => { %>
                                            <tr>
                                                <td>
                                                    <strong><%= visitor.firstName %> <%= visitor.lastName %></strong>
                                                    <% if (visitor.badge) { %>
                                                        <br><small class="text-muted">Badge: <%= visitor.badge.badgeId %></small>
                                                    <% } %>
                                                </td>
                                                <td><%= visitor.email %></td>
                                                <td><%= visitor.company || '-' %></td>
                                                <td>
                                                    <span class="badge bg-info"><%= visitor.visitReason %></span>
                                                    <% if (visitor.staff) { %>
                                                        <br><small class="text-muted">Staff: <%= visitor.staff.firstName %> <%= visitor.staff.lastName %></small>
                                                    <% } else if (visitor.formation) { %>
                                                        <br><small class="text-muted">Formation: <%= visitor.formation.name %></small>
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <% if (visitor.checkInTime) { %>
                                                        <%= new Date(visitor.checkInTime).toLocaleString('fr-FR') %>
                                                    <% } else { %>
                                                        -
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <% if (visitor.checkOutTime) { %>
                                                        <%= new Date(visitor.checkOutTime).toLocaleString('fr-FR') %>
                                                    <% } else { %>
                                                        -
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <% if (visitor.status === 'INSIDE') { %>
                                                        <span class="badge status-inside">À l'intérieur</span>
                                                    <% } else { %>
                                                        <span class="badge status-outside">À l'extérieur</span>
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <div class="btn-group btn-group-sm">
                                                        <button class="btn btn-outline-primary" title="Modifier">
                                                            <i class="fas fa-edit"></i>
                                                        </button>
                                                        <% if (visitor.status === 'INSIDE') { %>
                                                            <button class="btn btn-outline-warning" title="Faire sortir">
                                                                <i class="fas fa-sign-out-alt"></i>
                                                            </button>
                                                        <% } else { %>
                                                            <button class="btn btn-outline-success" title="Faire entrer">
                                                                <i class="fas fa-sign-in-alt"></i>
                                                            </button>
                                                        <% } %>
                                                        <button class="btn btn-outline-info" title="Historique">
                                                            <i class="fas fa-history"></i>
                                                        </button>
                                                        <button class="btn btn-outline-danger" title="Supprimer">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>

                            <!-- Pagination -->
                            <% if (pagination.totalPages > 1) { %>
                                <nav class="mt-4">
                                    <ul class="pagination justify-content-center">
                                        <% if (pagination.hasPrev) { %>
                                            <li class="page-item">
                                                <a class="page-link" href="?page=<%= pagination.prevPage %>&search=<%= filters.search %>&status=<%= filters.status %>&visitReason=<%= filters.visitReason %>">
                                                    Précédent
                                                </a>
                                            </li>
                                        <% } %>
                                        
                                        <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                                            <li class="page-item <%= pagination.page === i ? 'active' : '' %>">
                                                <a class="page-link" href="?page=<%= i %>&search=<%= filters.search %>&status=<%= filters.status %>&visitReason=<%= filters.visitReason %>">
                                                    <%= i %>
                                                </a>
                                            </li>
                                        <% } %>
                                        
                                        <% if (pagination.hasNext) { %>
                                            <li class="page-item">
                                                <a class="page-link" href="?page=<%= pagination.nextPage %>&search=<%= filters.search %>&status=<%= filters.status %>&visitReason=<%= filters.visitReason %>">
                                                    Suivant
                                                </a>
                                            </li>
                                        <% } %>
                                    </ul>
                                </nav>
                            <% } %>
                        <% } else { %>
                            <div class="text-center py-5">
                                <i class="fas fa-user-friends fa-4x text-muted mb-3"></i>
                                <h4 class="text-muted">Aucun visiteur trouvé</h4>
                                <p class="text-muted">Les visiteurs enregistrés apparaîtront ici.</p>
                            </div>
                        <% } %>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html> 