# ========================================
# GOOSECORP BACKEND - VARIABLES D'ENVIRONNEMENT
# ========================================
# 
# COPIEZ CE FICHIER EN .env ET REMPLACEZ LES VALEURS
# cp .env.example .env
#
# POUR LA PRODUCTION : cp .env.example .env.production

# ========================================
# ENVIRONNEMENT
# ========================================
NODE_ENV=development
PORT=3000

# ========================================
# BASE DE DONNÉES
# ========================================
# Local Docker
DATABASE_URL="postgresql://AdminDodol:12345@localhost:5432/gooseCorp_db"

# Production Railway (à remplacer)
# DATABASE_URL="postgresql://username:password@host:port/database"

# ========================================
# SÉCURITÉ - JWT & SESSIONS
# ========================================
# GÉNÉREZ DES SECRETS FORTS AVEC : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
SESSION_SECRET="your-super-secret-session-key-change-this-in-production"

# ========================================
# CORS & ORIGINES AUTORISÉES
# ========================================
# En développement : toutes les origines
# En production : spécifiez vos domaines
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:8080"

# ========================================
# RATE LIMITING
# ========================================
# Fenêtre de temps pour le rate limiting (en millisecondes)
RATE_LIMIT_WINDOW=900000
# Nombre max de requêtes par fenêtre
RATE_LIMIT_MAX_REQUESTS=100
# Rate limiting spécifique pour les tentatives de connexion
LOGIN_RATE_LIMIT_MAX=5
# Rate limiting pour les endpoints publics
PUBLIC_RATE_LIMIT_WINDOW=300000
PUBLIC_RATE_LIMIT_MAX=200
# Rate limiting pour l'inscription des visiteurs (anti-spam)
VISITOR_RATE_LIMIT_WINDOW=600000
VISITOR_RATE_LIMIT_MAX=10

# ========================================
# SESSIONS & COOKIES
# ========================================
# Durée de vie des cookies (en millisecondes) - 24h par défaut
COOKIE_MAX_AGE=86400000

# ========================================
# CREDENTIALS DOCKER (LOCAL SEULEMENT)
# ========================================
# Ces valeurs sont utilisées dans docker-compose.yml
POSTGRES_USER=AdminDodol
POSTGRES_PASSWORD=12345
POSTGRES_DB=gooseCorp_db

# ========================================
# PGPADMIN (LOCAL SEULEMENT)
# ========================================
PGADMIN_DEFAULT_EMAIL=admin@goosecorp.com
PGADMIN_DEFAULT_PASSWORD=admin123

# ========================================
# CREDENTIALS ADMIN PAR DÉFAUT
# ========================================
# Ces credentials sont créés par le script seed.js
# ADMIN PRINCIPAL
ADMIN_EMAIL=admin@goosecorp.com
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Administrateur Principal

# GESTIONNAIRE
MANAGER_EMAIL=manager@goosecorp.com
MANAGER_PASSWORD=Manager123!
MANAGER_NAME=Gestionnaire

# ========================================
# LOGGING & MONITORING
# ========================================
# Niveau de log (error, warn, info, debug)
LOG_LEVEL=info
# Activer les logs d'audit détaillés
AUDIT_LOGGING=true

# ========================================
# RAILWAY SPECIFIC (PRODUCTION)
# ========================================
# URL de votre application Railway
RAILWAY_APP_URL="https://your-app-name.railway.app"
# Nom de votre service Railway
RAILWAY_SERVICE_NAME="goosecorp-backend"

# ========================================
# SÉCURITÉ SUPPLÉMENTAIRE
# ========================================
# Clé pour le chiffrement des données sensibles (optionnel)
ENCRYPTION_KEY=""
# Clé pour les webhooks (optionnel)
WEBHOOK_SECRET=""

# ========================================
# NOTIFICATIONS (FUTUR)
# ========================================
# Email SMTP pour les notifications
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@goosecorp.com"

# ========================================
# INTÉGRATIONS EXTERNES (FUTUR)
# ========================================
# API Keys pour services externes
EXTERNAL_API_KEY=""
EXTERNAL_API_URL=""

# ========================================
# NOTES IMPORTANTES
# ========================================
# 
# 1. NE COMMITTEZ JAMAIS CE FICHIER .env DANS GIT
# 2. GÉNÉREZ DES SECRETS UNIQUES POUR LA PRODUCTION
# 3. UTILISEZ DES VARIABLES D'ENVIRONNEMENT RAILWAY
# 4. CHANGEZ LES MOTS DE PASSE PAR DÉFAUT
# 5. VÉRIFIEZ LES PERMISSIONS DES FICHIERS
#
# ========================================
